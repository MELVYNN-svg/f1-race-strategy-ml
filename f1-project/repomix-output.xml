from kedro.pipeline import Pipeline, node

from .nodes import get_sessions, get_meetings, download_all


def create_pipeline(**kwargs) -> Pipeline:
    return Pipeline([
        node(
            func=get_sessions,
            inputs="params:year",
            outputs="sessions",
            name="get_sessions",
        ),
        node(
            func=get_meetings,
            inputs="params:year",
            outputs="meetings",
            name="get_meetings",
        ),
        node(
            func=download_all,
            inputs=["sessions", "params:year"],
            outputs="ingestion_report",
            name="download_all",
        ),
    ])
