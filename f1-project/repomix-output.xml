import json
import time
from datetime import datetime, timezone
from pathlib import Path

import pandas as pd
import requests
from pyarrow.parquet import ParquetFile

BASE_URL = "https://api.openf1.org/v1"

ENDPOINTS = [
    "drivers",
    "laps",
    "stints",
    "pit",
    "weather",
    "intervals",
    "position",
    "race_control",
    "session_result",
    "starting_grid",
    "overtakes",
    "team_radio",
    "championship_drivers",
    "championship_teams",
    "car_data",
    "location",
]

TELEMETRY = {"car_data", "location"}
RACE_SESSIONS = {"Race", "Sprint"}

CHUNK_MINUTES = 5
REQUEST_DELAY = 2.2
MAX_RETRIES = 3

_last_request = 0.0

REPORT_COLUMNS = [
    "session_key",
    "endpoint",
    "status",
    "path",
    "rows",
    "message",
    "utc",
]


def fetch(endpoint, params):
    global _last_request

    for attempt in range(1, MAX_RETRIES + 1):

        elapsed = time.monotonic() - _last_request
        wait = max(0, REQUEST_DELAY - elapsed)

        if wait:
            time.sleep(wait)

        _last_request = time.monotonic()

        try:
            response = requests.get(
                f"{BASE_URL}/{endpoint}",
                params=params,
                timeout=(10, 60),
            )

            response.raise_for_status()
            records = response.json()

            if not isinstance(records, list):
                raise ValueError(
                    f"Réponse inattendue pour {endpoint}: "
                    f"{type(records).__name__}"
                )

            return records

        except requests.HTTPError as exc:
            status = exc.response.status_code

            if status in (401, 403):
                raise

            if status not in (429, 500, 502, 503, 504):
                raise

            if attempt == MAX_RETRIES:
                raise

            delay = 5 * attempt
            print(f"HTTP {status} sur {endpoint}. Retry dans {delay}s.", flush=True)
            time.sleep(delay)

        except (requests.Timeout, requests.ConnectionError) as exc:
            if attempt == MAX_RETRIES:
                raise

            delay = 5 * attempt
            print(f"Erreur réseau : {exc}. Retry dans {delay}s.", flush=True)
            time.sleep(delay)

    raise RuntimeError(f"Échec API : {endpoint}")


def to_df(records):
    df = pd.DataFrame(records)

    for col in df.select_dtypes(include=["object"]).columns:

        def convert(value):
            if isinstance(value, (list, dict)):
                return json.dumps(value, ensure_ascii=False)
            if value is None:
                return None
            return str(value)

        df[col] = df[col].map(convert).astype("string")

    return df


def get_sessions(year):
    print(f"Sessions {year}", flush=True)

    records = fetch("sessions", {"year": int(year)})
    df = to_df(records)

    if df.empty:
        raise ValueError(f"Aucune séance pour {year}")

    return df.sort_values("date_start").reset_index(drop=True)


def get_meetings(year):
    print(f"Meetings {year}", flush=True)

    records = fetch("meetings", {"year": int(year)})
    return to_df(records)


def record_event(
    report, log_path, key, endpoint,
    status, path="", rows=None, message=""
):
    event = {
        "session_key": key,
        "endpoint": endpoint,
        "status": status,
        "path": str(path),
        "rows": rows,
        "message": str(message),
        "utc": datetime.now(timezone.utc).isoformat(),
    }

    report.append(event)
    log_path.parent.mkdir(parents=True, exist_ok=True)

    with log_path.open("a", encoding="utf-8") as file:
        file.write(json.dumps(event, ensure_ascii=False) + "\n")

    print(
        f"[{status}] {endpoint}"
        + (f" | {rows} lignes" if rows is not None else "")
        + (f" | {message}" if message else ""),
        flush=True,
    )


def valid_parquet(path):
    if not path.exists():
        return False

    try:
        ParquetFile(str(path))
        return True

    except Exception:
        print(f"Fichier invalide : {path}", flush=True)
        path.unlink(missing_ok=True)
        return False


def save_endpoint(endpoint, key, path, params, report, log_path):
    empty_marker = path.with_suffix(".empty")
    temp_path = path.with_name(path.name + ".part")

    if valid_parquet(path):
        record_event(
            report, log_path, key, endpoint,
            "cached", path
        )
        return

    if empty_marker.exists():
        record_event(
            report, log_path, key, endpoint,
            "cached_empty", empty_marker
        )
        return

    try:
        records = fetch(endpoint, params)
        path.parent.mkdir(parents=True, exist_ok=True)

        if records:
            df = to_df(records)
            df.to_parquet(temp_path, index=False)
            temp_path.replace(path)

            record_event(
                report, log_path, key, endpoint,
                "saved", path, len(df)
            )

        else:
            empty_marker.touch()

            record_event(
                report, log_path, key, endpoint,
                "empty", empty_marker, 0
            )

    except Exception as exc:
        temp_path.unlink(missing_ok=True)

        record_event(
            report, log_path, key, endpoint,
            "error", path, message=str(exc)
        )

        if isinstance(exc, requests.HTTPError):
            status = exc.response.status_code

            if status in (401, 403, 429):
                raise RuntimeError(
                    f"OpenF1 HTTP {status}"
                ) from exc


def download_all(sessions, year):
    report = []
    root = Path("data/01_raw/openf1") / str(year)
    log_path = Path("data/08_reporting") / str(year) / "progress.jsonl"

    sessions = sessions.sort_values("date_start")
    total = len(sessions)

    for i, (_, session) in enumerate(sessions.iterrows(), start=1):
        key = int(session["session_key"])
        session_name = str(session["session_name"])
        folder = root / str(key)

        print(
            f"\nSESSION {i}/{total} : {session_name} ({key})",
            flush=True,
        )

        for endpoint in ENDPOINTS:
            print(
                f"Session {key} | Endpoint : {endpoint}",
                flush=True,
            )

            if endpoint in {
                "overtakes",
                "intervals",
                "starting_grid",
            } and session_name not in RACE_SESSIONS:
                continue

            if endpoint.startswith("championship_"):
                if session_name != "Race":
                    continue

            if endpoint not in TELEMETRY:
                save_endpoint(
                    endpoint=endpoint,
                    key=key,
                    path=folder / f"{endpoint}.parquet",
                    params={"session_key": key},
                    report=report,
                    log_path=log_path,
                )
                continue

            start = pd.to_datetime(
                session.get("date_start"),
                utc=True,
                errors="coerce",
            )

            end = pd.to_datetime(
                session.get("date_end"),
                utc=True,
                errors="coerce",
            )

            if pd.isna(start) or pd.isna(end) or end <= start:
                record_event(
                    report, log_path, key, endpoint,
                    "invalid_dates",
                    message="Dates indisponibles"
                )
                continue

            start -= pd.Timedelta(minutes=30)
            end += pd.Timedelta(minutes=30)

            while start < end:
                stop = min(
                    start + pd.Timedelta(minutes=CHUNK_MINUTES),
                    end,
                )

                filename = (
                    f"{start:%Y%m%dT%H%M%S}_"
                    f"{stop:%Y%m%dT%H%M%S}.parquet"
                )

                path = folder / endpoint / filename

                print(
                    f"{endpoint} | {start} -> {stop}",
                    flush=True,
                )

                save_endpoint(
                    endpoint=endpoint,
                    key=key,
                    path=path,
                    params={
                        "session_key": key,
                        "date>=": start.isoformat(),
                        "date<": stop.isoformat(),
                    },
                    report=report,
                    log_path=log_path,
                )

                start = stop

    result = pd.DataFrame(report, columns=REPORT_COLUMNS)

    print("\nTéléchargement terminé.", flush=True)

    if not result.empty:
        print(
            result.groupby(["endpoint", "status"]).size(),
            flush=True,
        )

    return result
